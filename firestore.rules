rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Family documents
    match /families/{familyId} {
      // Creating a new family: check the members array in the incoming data
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;

      // Reading or updating an existing family: check existing members array
      allow read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // All sub-collections are accessible to family members
      match /{collection}/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }
  }
}
