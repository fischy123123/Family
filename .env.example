# ─────────────────────────────────────────────────────────────
# REQUIRED — Firebase (Console → Project Settings → Your apps → Web app)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# REQUIRED for AI features (Quick Add, meal/list generation, Gmail)
# Get a key at console.anthropic.com
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# REQUIRED for the Copilot real-time VOICE conversation
# (text Copilot uses Anthropic above; only voice uses OpenAI)
# Get a key at platform.openai.com — account needs Realtime API access
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — Web search (Tavily)
# Free tier: 1,000 searches/month — https://app.tavily.com
# ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────
# OPTIONAL — Push notifications
# VAPID key: Firebase Console → Project Settings → Cloud Messaging →
#   Web Push certificates → "Generate key pair"
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Service account JSON (one line) for the daily-digest cron to send push.
# Firebase Console → Project Settings → Service accounts → Generate new
#   private key. Paste the whole JSON file contents as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# Any random string — protects the cron endpoint. Set the same value in Vercel.
CRON_SECRET=
