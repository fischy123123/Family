# Google OAuth — create at console.cloud.google.com
# Enable: Calendar API, Gmail API, Sheets API, Drive API
# Create OAuth 2.0 Web credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-app.vercel.app

# Claude AI (Anthropic Console — console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Sheets ID (from the shared spreadsheet URL)
# URL format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
FAMILY_SHEET_ID=

# Web Push VAPID Keys
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@gmail.com

# Also add this to Vercel env as NEXT_PUBLIC_VAPID_PUBLIC_KEY (public key only)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron job secret (any random string)
CRON_SECRET=

# Optional: Google access token for cron job to read Sheets without user session
# Set this to a long-lived token from a family member's Google account
CRON_GOOGLE_ACCESS_TOKEN=
